<form
    method="post"
    action="{{ path('app_category_delete', {'id': category.id}) }}"
    onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette catégorie ?');"
>
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
    <button
        type="submit"
        class="px-4 py-2 text-sm font-medium text-red-400 bg-gray-800 border border-gray-700 rounded-lg hover:bg-red-600 hover:text-white hover:border-red-600 transition"
    >
        Supprimer
    </button>
</form>
