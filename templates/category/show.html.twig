{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} — CineTech{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

        <a
            href="{{ path('app_category_index') }}"
            class="inline-flex items-center gap-2 text-sm font-medium text-gray-400 hover:text-white transition"
        >
            ← Retour aux catégories
        </a>

        <div class="mt-6 bg-gray-900 border border-gray-800 rounded-xl p-6 sm:p-8">
            <div class="flex items-center justify-between gap-4 pb-6 border-b border-gray-800">
                <div>
                    <span class="inline-block px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-red-400 bg-gray-800 border border-gray-700 rounded-md">
                        Catégorie
                    </span>
                    <h1 class="mt-2 text-2xl font-bold text-white">{{ category.name }}</h1>
                </div>
                <span class="px-3 py-1 text-xs font-mono text-gray-400 bg-gray-800 border border-gray-700 rounded-lg">
                    ID #{{ category.id }}
                </span>
            </div>

            <dl class="mt-6 divide-y divide-gray-800 text-sm">
                <div class="py-4 flex items-center justify-between">
                    <dt class="font-medium text-gray-400">Identifiant</dt>
                    <dd class="font-mono text-white">{{ category.id }}</dd>
                </div>
                <div class="py-4 flex items-center justify-between">
                    <dt class="font-medium text-gray-400">Nom de la catégorie</dt>
                    <dd class="font-semibold text-white">{{ category.name }}</dd>
                </div>
            </dl>

            <div class="mt-8 pt-6 border-t border-gray-800 flex items-center justify-between gap-4">
                <a
                    href="{{ path('app_category_edit', {'id': category.id}) }}"
                    class="px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 transition"
                >
                    Modifier
                </a>

                {{ include('category/_delete_form.html.twig') }}
            </div>
        </div>

    </div>
{% endblock %}
