{% extends 'base.html.twig' %}

{% block title %}Inscription — CineTech{% endblock %}

{% block body %}
    <div class="max-w-md mx-auto px-4 sm:px-6 py-12">

        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 sm:p-8">
            <div class="text-center pb-6 mb-6 border-b border-gray-800">
                <span class="inline-flex items-center justify-center w-11 h-11 rounded-lg bg-red-600 text-white mb-4">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                    </svg>
                </span>
                <h1 class="text-2xl font-bold text-white">Créer un compte</h1>
                <p class="mt-1 text-sm text-gray-400">
                    Rejoignez Cine<span class="text-red-500 font-semibold">Tech</span> pour accéder au catalogue.
                </p>
            </div>

            <div class="mb-4 text-sm text-red-400">
                {{ form_errors(registrationForm) }}
            </div>

            {{ form_start(registrationForm, {'attr': {'class': 'space-y-5'}}) }}

                <div>
                    {{ form_label(registrationForm.email, 'Adresse email', {
                    'label_attr': {'class': 'block text-sm font-medium text-gray-200 mb-2'}
                }) }}
                    {{ form_widget(registrationForm.email, {
                    'attr': {
                        'class': 'w-full px-4 py-2.5 text-sm text-white bg-gray-800 border border-gray-700 rounded-lg focus:outline-none focus:border-red-500',
                        'placeholder': 'exemple@cinetech.fr'
                    }
                }) }}
                    <div class="mt-1 text-xs text-red-400">
                        {{ form_errors(registrationForm.email) }}
                    </div>
                </div>

                <div>
                    {{ form_label(registrationForm.plainPassword, 'Mot de passe', {
                    'label_attr': {'class': 'block text-sm font-medium text-gray-200 mb-2'}
                }) }}
                    {{ form_widget(registrationForm.plainPassword, {
                    'attr': {
                        'class': 'w-full px-4 py-2.5 text-sm text-white bg-gray-800 border border-gray-700 rounded-lg focus:outline-none focus:border-red-500',
                        'placeholder': '••••••••'
                    }
                }) }}
                    <div class="mt-1 text-xs text-red-400">
                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>
                </div>

                <div>
                    <div class="flex items-center gap-3">
                        {{ form_widget(registrationForm.agreeTerms, {
                        'attr': {'class': 'w-4 h-4 bg-gray-800 border-gray-700 rounded text-red-600 focus:ring-0'}
                    }) }}
                        {{ form_label(registrationForm.agreeTerms, "J'accepte les conditions d'utilisation", {
                        'label_attr': {'class': 'text-sm text-gray-300'}
                    }) }}
                    </div>
                    <div class="mt-1 text-xs text-red-400">
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>
                </div>

                <button
                    type="submit"
                    class="w-full py-2.5 px-4 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 transition"
                >
                    S'inscrire
                </button>

            {{ form_end(registrationForm) }}

            <p class="mt-6 pt-6 border-t border-gray-800 text-center text-sm text-gray-400">
                Déjà un compte ?
                <a href="{{ path('app_login') }}" class="font-medium text-red-400 hover:text-red-300 transition">
                    Se connecter
                </a>
            </p>
        </div>

    </div>
{% endblock %}
