{% extends 'base.html.twig' %}

{% block title %}{{ game.name }} - GameTech{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto px-6 py-10">
        <a
            href="{{ path('app_game_index') }}"
            class="inline-flex items-center gap-2 mb-6 text-sm font-medium text-gray-600 transition hover:text-gray-900"
        >
            ← Retour au catalogue
        </a>

        <div class="overflow-hidden rounded-2xl border border-gray-800 bg-gray-900 shadow-xl">
            <div class="h-32 bg-gradient-to-br from-red-600/50 via-red-900/20 to-transparent"></div>

            <div class="p-8 -mt-10">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <span class="px-2.5 py-1 text-xs font-semibold text-red-300 bg-red-500/20 border border-red-500/30 rounded-md">
                            {{ game.category.name }}
                        </span>
                        <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-white">
                            {{ game.name|upper }}
                        </h1>
                    </div>

                    {% if game.rating >= 9.3 %}
                        <span class="px-3 py-1 text-sm font-semibold text-yellow-300 bg-yellow-500/15 border border-yellow-500/30 rounded-full">
                            ⭐ Coup de coeur
                        </span>
                    {% endif %}
                </div>

                <dl class="grid grid-cols-2 gap-4 mt-8">
                    <div class="p-4 rounded-xl bg-gray-800/80 border border-white/10">
                        <dt class="text-xs font-medium uppercase tracking-wider text-gray-400">Année</dt>
                        <dd class="mt-1 text-xl font-semibold text-white">{{ game.annee }}</dd>
                    </div>
                    <div class="p-4 rounded-xl bg-gray-800/80 border border-white/10">
                        <dt class="text-xs font-medium uppercase tracking-wider text-gray-400">Note</dt>
                        <dd class="mt-1 text-xl font-semibold text-yellow-400">{{ game.rating|number_format(1) }} / 10</dd>
                    </div>
                    <div class="p-4 rounded-xl bg-gray-800/80 border border-white/10">
                        <dt class="text-xs font-medium uppercase tracking-wider text-gray-400">Catégorie</dt>
                        <dd class="mt-1 text-xl font-semibold text-white">{{ game.category.name }}</dd>
                    </div>
                    <div class="p-4 rounded-xl bg-gray-800/80 border border-white/10">
                        <dt class="text-xs font-medium uppercase tracking-wider text-gray-400">Référence</dt>
                        <dd class="mt-1 text-xl font-semibold text-white">#{{ game.id }}</dd>
                    </div>
                </dl>

                {% if game.synopsis %}
                    <div class="mt-6 p-4 rounded-xl bg-gray-800/80 border border-white/10">
                        <h2 class="text-xs font-medium uppercase tracking-wider text-gray-400">Synopsis</h2>
                        <p class="mt-2 text-sm leading-relaxed text-gray-300">{{ game.synopsis }}</p>
                    </div>
                {% endif %}
                <a
                    href="{{ path('app_game_edit', {id: game.id}) }}"
                    class="mt-6 p-4 rounded-xl block px-3 py-2 rounded-lg text-sm font-semibold text-center text-white bg-red-600 shadow-lg shadow-red-600/20 transition hover:bg-red-500"
                >
                    Modifier la fiche
                </a>    
                <form
                    method="post"
                    action="{{ path('app_game_delete', {id: game.id}) }}"
                    onsubmit="return confirm('Supprimer définitivement ce jeu ?');"
                >
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token('delete' ~ game.id) }}"
                    >
                    <button type="submit" class="mt-6 p-4 rounded-xl text-sm font-semibold text-center text-white bg-red-600 shadow-lg shadow-red-600/20 transition hover:bg-red-500">
                        Supprimer
                    </button>
                </form>
         
            </div>
        </div>
    </div>
{% endblock %}
