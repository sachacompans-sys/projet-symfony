{% extends 'base.html.twig' %}

{% block title %}Hello GameController!{% endblock %}

{% block body %}

    <div class="max-w-4xl mx-auto px-6 py-10">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold">Catalogue</h2>
            <span class="px-3 py-1 text-sm font-medium text-red-400 bg-red-500/10 border border-red-500/20 rounded-full">
                {{ games|length }} jeu{{ games|length > 1 ? 'x' : '' }}
            </span>
        </div>

        <div class="overflow-hidden rounded-xl border border-white/10 bg-gray-800/50">
            <table class="w-full text-left">
                <thead class="bg-gray-800 text-xs uppercase tracking-wider text-gray-400">
                    <tr>
                        <th class="px-6 py-3">Nom</th>
                        <th class="px-6 py-3">Année</th>
                        <th class="px-6 py-3">Genre</th>
                        <th class="px-6 py-3">Note</th>
                        <th class="px-6 py-3">Coup de coeur</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    {% for game in games %}
                        <tr class="hover:bg-white/5 transition">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-4">
                                    <span class="font-semibold text-white">{{ game.name|upper }}</span>
                                    <a href="{{ path('app_game_show', {id: game.id}) }}" class="inline-flex items-center px-3 py-1.5 text-xs font-semibold text-white bg-red-600 rounded-lg shadow-lg shadow-red-600/20 transition hover:bg-red-500 hover:-translate-y-0.5 active:translate-y-0">
                                        Détails
                                    </a>
                                </div>
                            </td>   
                            <td class="px-6 py-4 text-gray-300">{{ game.annee }}</td>
                            <td class="px-6 py-4">
                                <span class="px-2.5 py-1 text-xs font-medium text-red-300 bg-red-500/10 rounded-md">
                                    {{ game.genre }}
                                </span>
                            </td>

                            <td class="px-6 py-4">
                                <span class="px-2.5 py-1 text-xs font-medium text-yellow-300 bg-yellow-500/10 rounded-md">
                                    {{ game.rating }}
                                </span>
                            </td>
                            <td class="px-14 py-4">
                                {% if game.rating >= 9.3 %}⭐{% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="px-6 py-10 text-center text-gray-500">
                                Aucun jeu trouvé.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
{% endblock %}
