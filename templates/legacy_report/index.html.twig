{% extends 'base.html.twig' %}

{% block title %}Rapport Catalogue Jeux — GameStore{% endblock %}

{% block body %}
    <div class="max-w-5xl mx-auto px-6 py-10">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-8 border-b border-white/10">
            <div>
                <span class="inline-flex items-center gap-2 px-3 py-1 text-xs font-semibold tracking-wider uppercase text-red-400 bg-red-500/10 border border-red-500/20 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                    Module Statistiques · Store Gaming
                </span>
                <h1 class="mt-3 text-3xl font-bold tracking-tight text-white">
                    Rapport & Simulation Tarifs Jeux
                </h1>
                <p class="mt-1 text-sm text-gray-400">
                    Synthèse des notes de la communauté et simulation de la grille tarifaire Store.
                </p>
            </div>

            <div class="inline-flex items-center gap-2 px-4 py-2 text-xs font-medium text-emerald-300 bg-emerald-500/10 border border-emerald-500/20 rounded-xl self-start sm:self-auto">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                Service opérationnel (HTTP 200)
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-8">

            {# Carte 1 : Notes moyennes des jeux #}
            <section class="bg-gray-900/90 border border-white/10 rounded-2xl p-6 shadow-xl">
                <div class="flex items-center justify-between pb-4 mb-5 border-b border-white/10">
                    <div class="flex items-center gap-3">
                        <div class="flex items-center justify-center w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                        </div>
                        <h2 class="text-lg font-semibold text-white">Notes moyennes des jeux</h2>
                    </div>
                    <span class="px-2.5 py-1 text-xs font-medium text-gray-400 bg-white/5 border border-white/10 rounded-lg">
                        {{ report|length }} titre{{ report|length > 1 ? 's' : '' }}
                    </span>
                </div>

                <ul class="space-y-3">
                    {% for item in report %}
                        <li class="flex items-center justify-between gap-4 p-4 rounded-xl bg-gray-800/60 border border-white/5 hover:border-white/15 transition">
                            <span class="text-sm font-medium text-gray-200">
                                {{ item.label }}
                            </span>
                            <span class="inline-flex items-center gap-1 px-3 py-1 text-sm font-bold text-amber-300 bg-amber-500/10 border border-amber-500/20 rounded-lg shrink-0">
                                {{ item.average }}
                                <span class="text-xs font-normal text-amber-300/60">/ 5</span>
                            </span>
                        </li>
                    {% else %}
                        <li class="p-4 text-sm text-center text-gray-500 bg-gray-800/30 border border-dashed border-white/10 rounded-xl">
                            Aucune note enregistrée pour le moment.
                        </li>
                    {% endfor %}
                </ul>
            </section>

            {# Carte 2 : Simulation Tarifs Store #}
            <section class="bg-gray-900/90 border border-white/10 rounded-2xl p-6 shadow-xl">
                <div class="flex items-center justify-between pb-4 mb-5 border-b border-white/10">
                    <div class="flex items-center gap-3">
                        <div class="flex items-center justify-center w-9 h-9 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <h2 class="text-lg font-semibold text-white">Simulation Tarifs Store</h2>
                    </div>
                    <span class="px-2.5 py-1 text-xs font-semibold text-red-300 bg-red-500/10 border border-red-500/20 rounded-lg">
                        Base 60 €
                    </span>
                </div>

                <ul class="space-y-3">
                    {% for label, price in prices %}
                        <li class="flex items-center justify-between gap-4 p-4 rounded-xl bg-gray-800/60 border border-white/5 hover:border-red-500/30 transition">
                            <span class="text-sm font-medium text-gray-300">
                                {{ label }}
                            </span>
                            <span class="px-3 py-1 text-sm font-bold text-white bg-white/5 border border-white/10 rounded-lg shrink-0">
                                {{ price|number_format(2, ',', ' ') }} €
                            </span>
                        </li>
                    {% else %}
                        <li class="p-4 text-sm text-center text-gray-500 bg-gray-800/30 border border-dashed border-white/10 rounded-xl">
                            Aucun tarif simulé.
                        </li>
                    {% endfor %}
                </ul>
            </section>

        </div>
    </div>
{% endblock %}
